# CheckCC Docker deployment settings.
# These values are read at build time. Re-run ./deploy/deploy.sh after changing them.

# Public site URL used for canonical, hreflang, OG URL, and sitemap.
# Leave empty to omit those fields and avoid pointing at the wrong site.
NEXT_PUBLIC_SITE_URL=

# Repository shown in the header and footer.
NEXT_PUBLIC_REPO_URL=https://github.com/Brilliant666/check-cc

# Network layer: true makes the opt-in available; false removes it entirely.
NEXT_PUBLIC_IP_INTEL_ENABLED=true
NEXT_PUBLIC_IP_INTEL_ENDPOINT=https://ipwho.is/
# Tried automatically when the primary endpoint fails or rate-limits. Set to empty to disable.
NEXT_PUBLIC_IP_INTEL_FALLBACK_ENDPOINT=https://ipapi.co/json/
# STUN server used to gather WebRTC egress candidates when the network layer is on.
NEXT_PUBLIC_WEBRTC_STUN_URL=stun:stun.cloudflare.com:3478

# Host binding and port. Use 127.0.0.1 when a reverse proxy is in front.
CHECKCC_BIND=0.0.0.0
CHECKCC_PORT=8080
